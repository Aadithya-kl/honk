{
  "name": "irc",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --hot src/index.tsx",
    "watch": "bun --watch src/index.tsx",
    "start": "bun run src/index.tsx",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.tsx --compile --outfile dist/irc",
    "release": "bun scripts/release.ts"
  },
  "dependencies": {
    "@opentui/core": "0.9.4",
    "@opentui/react": "0.9.4",
    "irc-client-ts": "^0.23.1",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "@types/react": "^19.2.0",
    "typescript": "^5.9.0"
  }
}
